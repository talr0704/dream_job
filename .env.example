# Frontend: public Firebase project configuration, never an OpenAI key
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Backend only; inject through Secret Manager in production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ALLOWED_EMAILS=your-verified-email@example.com
ALLOWED_ORIGIN=http://localhost:5173
GOOGLE_CLOUD_PROJECT=
PORT=3001
# Explicit local-only mode: deterministic fixture generation, no OpenAI calls
LOCAL_DEMO=false
