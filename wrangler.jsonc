{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dream-job-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "observability": { "enabled": false },
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini",
