    "ACCESS_AUD": "3d935a1b79768cce6a09e6425da1b75deef48446e252988b17dd2924b3ee2c94",
    "ACCESS_TEAM_DOMAIN": "ancient-sun-7f49.cloudflareaccess.com",
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
