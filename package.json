{
  "name": "dream-job",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:legacy": "node --test tests/unit.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "test:workspace": "vitest run tests/cloudflare/storage.test.ts",
    "test:ui": "playwright test",
    "worker:dev": "wrangler dev --local",
    "worker:check": "wrangler deploy --dry-run --outdir work/worker-build",
    "worker:deploy": "node scripts/deploy-worker.mjs",
    "build:same-origin": "node scripts/build-same-origin.mjs",
    "worker:check:same-origin": "wrangler deploy --dry-run --config wrangler.same-origin.jsonc --outdir work/same-origin-build"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@sparticuz/chromium": "^153.0.0",
    "@vitejs/plugin-react": "latest",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "jose": "^6.2.13",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.56.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.6",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
