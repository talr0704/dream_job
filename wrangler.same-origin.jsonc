{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dream-job-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "observability": {
    "enabled": false,
  },
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini",
    "ALLOWED_ORIGIN": "",
    "ACCESS_AUD": "",
    "ACCESS_TEAM_DOMAIN": "",
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
